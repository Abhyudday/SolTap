<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Badge -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@color/status_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Amount Info -->
        <TextView
            android:id="@+id/solAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.5000 SOL"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/fiatAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75.00 USD"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/timestampText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 17, 14:30"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="8dp" />

        <!-- Agent Info -->
        <TextView
            android:id="@+id/agentInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for agent..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Timer -->
        <TextView
            android:id="@+id/timerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dispute window: 1:45"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

